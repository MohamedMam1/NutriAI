@{ Layout = "_AuthLayout"; ViewData["Title"] = "Confirm Email"; }
<div class="auth-wrapper">
    <div class="auth-card text-center">
        <h2 class="h4 text-success">Confirm your email</h2>
        <p class="text-muted">@TempData["Success"]</p>
        <p class="small-text">Didn't receive it?</p>
        <form asp-action="ResendConfirmation" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="email" name="email" class="form-control form-control-nutri mb-2" placeholder="Your email" required />
            <button type="submit" class="btn btn-outline-nutri w-100">Resend confirmation</button>
        </form>
    </div>
</div>
